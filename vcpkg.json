{
  "name": "vcpkg-example",
  "version": "0.0.1",
  "dependencies": [
    "eigen3",
    "fmt",
    "glad",
    "glfw3",
    "glm",
    {
      "name": "imgui",
      "features": [
        "docking-experimental",
        "glfw-binding",
        "opengl3-binding"
      ]
    },
    "imguizmo",
    "openfbx",
    "pybind11",
    "stb",
    "tinyobjloader",
    "tinyxml2",
    "mikktspace"
  ],
  "features": {
    "wheel-usd": {
      "description": "Build the redistributable wheel with the OpenUSD runtime",
      "dependencies": [
        {
          "name": "usd",
          "default-features": false
        }
      ]
    }
  }
}
